---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import ArticuloTeaser from '../components/ArticuloTeaser.astro';
import { getCollection } from 'astro:content';
import Clinica from '../components/ClinicaDeObra.astro';

// Artículos publicados, ordenados por fecha real (más nuevo primero). Automático.
const articulos = (await getCollection('articulos', ({ data }) => !data.draft))
  .sort((a, b) => b.data.fechaISO.getTime() - a.data.fechaISO.getTime());

// Solo los 3 más recientes van a la portada. El resto vive en /escritos/.
const destacados = articulos.slice(0, 3);
---

<Layout>

<!-- ── HERO ── -->
<section class="hero" aria-label="Presentación">
  <div class="hero-foto">
    <img src="/foto.jpg" alt="Matías J. Ortiz" loading="eager">
  </div>
  <div class="hero-texto">
    <span class="hero-etiqueta">Rosario · Santa Fe · Argentina</span>
    <h1 class="hero-nombre">Matías <em>J. Ortiz</em></h1>
    <p class="hero-bajada">
      Desde adentro del trabajo. Rosario, el Paraná, el silencio heredado.<br>
    </p>
    <div class="hero-datos">
      <span><strong>Publicado en:</strong> Custodio / Antología Una Sombra Común / Editorial Patas de Cabra · La Granja / Distopía Nébula / Editorial Rubin</span>
      <span><strong>Inédito: Promesa y Castigo · Metal Que Crece · El Lomo · Egixi · La Religión de los Diablos</span>
      <span><strong>Laburante. Escritor. Rosarino.</strong></span>
    </div>
    <svg class="raiz-deco" viewBox="0 0 200 300" aria-hidden="true">
      <path d="M100,0 C100,0 80,60 60,90 C40,120 20,130 30,160 C40,190 80,180 90,210 C100,240 85,280 100,300" stroke="rgba(127,196,122,0.8)" stroke-width="2" fill="none"/>
      <path d="M100,80 C100,80 130,100 150,130 C160,150 155,180 140,190" stroke="rgba(127,196,122,0.5)" stroke-width="1.5" fill="none"/>
      <path d="M90,140 C90,140 60,155 50,175 C45,190 55,205 65,200" stroke="rgba(127,196,122,0.4)" stroke-width="1" fill="none"/>
      <circle cx="100" cy="0" r="3" fill="rgba(127,196,122,0.6)"/>
      <circle cx="140" cy="190" r="2" fill="rgba(127,196,122,0.4)"/>
      <circle cx="65" cy="200" r="2" fill="rgba(127,196,122,0.4)"/>
    </svg>
  </div>
</section>

<div class="contenedor">

  <!-- SIDEBAR IZQ -->
<aside class="sidebar-izq" aria-label="Publicaciones y proyectos">

  <div class="widget">
    <h2 class="widget-titulo">Publicaciones</h2>

    <div class="pub-item">
      <div class="pub-titulo">Custodio</div>
      <div class="pub-donde">Editorial Patas de Cabra · Rosario</div>
      <span class="estado-badge badge-publicado">PUBLICADO</span>
    </div>

    <div class="pub-item">
      <div class="pub-titulo">La Granja</div>
      <div class="pub-donde">Distopía Nébula / Editorial Rubin</div>
      <span class="estado-badge badge-publicado">PUBLICADO</span>
    </div>

    <div class="pub-item">
      <div class="pub-titulo">Promesa y Castigo</div>
      <div class="pub-donde">Once herencias malditas del litoral</div>
      <span class="estado-badge badge-inedito">INÉDITO</span>
    </div>

    <div class="pub-item">
      <div class="pub-titulo">Metal Que Crece</div>
      <div class="pub-donde">Novela Breve / Universo Egixi</div>
      <span class="estado-badge badge-inedito">INÉDITO</span>
    </div>

    <div class="pub-item">
      <div class="pub-titulo">El Lomo</div>
      <div class="pub-donde">Siete cuentos del cordón industrial</div>
      <span class="estado-badge badge-inedito">INÉDITO</span>
    </div>

    <div class="pub-item">
      <div class="pub-titulo">Egixi</div>
      <div class="pub-donde">Seis relatos de la ocupación</div>
      <span class="estado-badge badge-inedito">INÉDITO</span>
    </div>

  </div>

  <div class="widget">
    <h2 class="widget-titulo">Escribiendo ahora</h2>
    <div class="escribiendo-item">La Criadora / Novela</div>
    <div class="escribiendo-item">Reina Madre / Novela Corta</div>
  </div>

</aside>

  <!-- FEED PRINCIPAL: solo los 2 más recientes + acceso al archivo -->
  <main class="feed" id="escritos" aria-label="Escritos recientes">
    {destacados.map((art) => (
      <ArticuloTeaser
        slug={art.slug}
        titulo={art.data.titulo}
        tipo={art.data.tipo}
        fecha={art.data.fecha}
        imagen={art.data.imagen}
        imagenAlt={art.data.imagenAlt}
        pintura={art.data.pintura}
        resumen={art.data.seoDescripcion}
      />
    ))}

    <a class="ver-mas-escritos" href="/escritos/">Leer más artículos →</a>
  </main>

  <!-- SIDEBAR DER -->
  <aside class="sidebar-der" aria-label="Lecturas">
    <div class="widget">
      <h2 class="widget-titulo">Leyendo ahora</h2>
      <div class="lectura-item"><div class="lectura-titulo">Trafalgar</div><div class="lectura-autor">Angélica Gorodischer</div></div>
      <div class="lectura-item"><div class="lectura-titulo">Annihilation</div><div class="lectura-autor">Jeff VanderMeer</div></div>
      <div class="lectura-item"><div class="lectura-titulo">Zama</div><div class="lectura-autor">Antonio Di Benedetto</div></div>
      <div class="lectura-item"><div class="lectura-titulo">Ladrilleros</div><div class="lectura-autor">Selva Almada</div></div>
      <div class="lectura-item"><div class="lectura-titulo">Los pichiciegos</div><div class="lectura-autor">Rodolfo Fogwill</div></div>
      <div class="lectura-item"><div class="lectura-titulo">Operación Masacre</div><div class="lectura-autor">Rodolfo Walsh</div></div>
      <div class="lectura-item"><div class="lectura-titulo">Distancia de rescate</div><div class="lectura-autor">Samanta Schweblin</div></div>
    </div>
  </aside>

</div>

{/* <Clinica /> */}

<!-- ── SOBRE MÍ ── -->
<section class="sobre-mi" id="sobre" aria-label="Sobre el autor">
  <div class="sobre-mi-grid">
    <h2>Sobre mí</h2>
    <div class="sobre-foto">
      <img src="/foto2.JPG" alt="Matías J. Ortiz" loading="lazy">
      <span class="sobre-foto-nombre">Matías J. Ortiz · Rosario</span>
    </div>
    <div class="sobre-texto">
      <p>Me llamo Matías Joel Ortiz. Nací y vivo en Rosario, Santa Fe. Laboro nueve horas por día. El resto del tiempo le pego a las teclas hasta que las articulaciones duelen.</p>
      <p>Tengo mucho escrito: <em>Promesa y Castigo</em> —once herencias malditas del litoral santafesino— y <em>Metal Que Crece</em>, una novela corta que entrelaza seis voces de la Argentina ocupada.<em> Egixi</em>, seis relatos de la ocupación, y <em>El Lomo</em>, siete cuentos del cordón industrial santafesino. En <em>El Lomo</em>, los siete cuentos van de <em>Las Delicias</em> a <em>El Fondero</em>. La pieza que más demora me trajo —y la que más cierra el libro— es <em>La Despostadora</em>: una mujer de sesenta y dos años, despostando para Swift desde 1976. Tengo en mi cajón otra novela: <em>La Religión De Los Diablos</em>. Y otras dos por finalizar: <em>La Criadora</em> y <em>Reina Madre</em>.</p>
      <p>Toco el piano. Hago teatro. Leo casi todo lo que encuentro. Tengo hambre de muchas cosas y la cabeza llena de historias por escribir.</p>
      <p>La literatura argentina tiene muchas voces porteñas, muchas voces académicas. Yo no vengo de ahí. Escribo ciencia ficción desde mi cuerpo, las herencias malditas las escribo desde mi árbol genealógico. A <em>El Lomo</em> lo terminé de pulir un primero de mayo. Es lo que soy.</p>
    </div>
  </div>
</section>

</Layout>

<style>
  .ver-mas-escritos {
    display: inline-block; margin-top: 2rem;
    font-family: 'Barlow Condensed', sans-serif; text-transform: uppercase;
    letter-spacing: .05em; color: var(--oxido); text-decoration: none;
    border: 1px solid var(--oxido); padding: .6rem 1.4rem; transition: all .2s ease;
  }
  .ver-mas-escritos:hover { background: var(--oxido); color: var(--negro); }
</style>
