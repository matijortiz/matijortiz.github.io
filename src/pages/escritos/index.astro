---
// src/pages/escritos/index.astro — archivo completo de escritos
import Layout from '../../layouts/Layout.astro';
import ArticuloTeaser from '../../components/ArticuloTeaser.astro';
import { getCollection } from 'astro:content';

const articulos = (await getCollection('articulos', ({ data }) => !data.draft))
  .sort((a, b) => b.data.fechaISO.getTime() - a.data.fechaISO.getTime());
---
<Layout
  seoTitulo="Escritos — Matias J. Ortiz | Sobre los relatos y el oficio"
  seoDescripcion="Todos los escritos de Matias J. Ortiz: notas sobre sus relatos, proceso de escritura y miradas sobre la literatura desde Rosario."
>
  <section class="archivo">
    <header class="archivo-header">
      <span class="hero-etiqueta">Cuaderno</span>
      <h1 class="archivo-titulo">Escritos</h1>
      <p class="archivo-bajada">Notas sobre los relatos, el proceso y lo que se lee desde adentro del trabajo.</p>
    </header>
    <div class="archivo-lista">
      {articulos.map((art) => (
        <ArticuloTeaser
          slug={art.slug}
          titulo={art.data.titulo}
          tipo={art.data.tipo}
          fecha={art.data.fecha}
          imagen={art.data.imagen}
          imagenAlt={art.data.imagenAlt}
          pintura={art.data.pintura}
          resumen={art.data.seoDescripcion}
        />
      ))}
    </div>
    <a class="archivo-volver" href="/">← Volver a la portada</a>
  </section>
</Layout>

<style>
  .archivo { max-width: 820px; margin: 0 auto; padding: 3.5rem 1.5rem 5rem; }
  .archivo-header { margin-bottom: 1.5rem; }
  .archivo-titulo { font-family: 'Cormorant Garamond', serif; font-size: 3rem; color: var(--crema); margin: .3rem 0; }
  .archivo-bajada { color: var(--gris); font-family: 'Barlow', sans-serif; font-weight: 300; max-width: 48ch; }
  .archivo-volver { display: inline-block; margin-top: 2.5rem; color: var(--oxido); text-decoration: none; font-family: 'Barlow Condensed', sans-serif; text-transform: uppercase; letter-spacing: .04em; }
  .archivo-volver:hover { color: var(--ambar); }
</style>
