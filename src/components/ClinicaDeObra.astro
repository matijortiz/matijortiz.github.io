---
// src/components/ClinicaDeObra.astro
// Sección "Servicios": tres tarjetas diferenciadas por un sistema de acento por nivel
// (pestaña superior + número + precio + divisor en el color de cada una), sin cambiar el
// fondo. Encabezado con más peso, tarjetas balanceadas, CTA con más carácter.

const tiers = [
  {
    num: "I",
    acc: "var(--oxido)",
    nombre: "Devolución Cruda",
    desc: "Te leo con hambre de saber qué te hace diferente a los miles de manuscritos que se escriben por año. Te hago una carta de devolución honesta: dónde estás fuerte, dónde el texto se cae y necesitás afilar, y por dónde seguir.",
    precio: "Desde USD 35",
  },
  {
    num: "II",
    acc: "var(--ambar)",
    nombre: "Corrección + Devolución Cruda",
    desc: "Lo anterior más correcciones párrafo a párrafo. Pero acá no corregimos tu estilo: lo identificamos hasta que sepa pegar. Cada voz es única.",
    precio: "Desde USD 90",
  },
  {
    num: "III",
    acc: "var(--raiz)",
    nombre: "Curaduría de Obra",
    desc: "Laburo sobre un manuscrito completo. Hacemos videollamada, varias rondas, corrección y seguimiento hasta que tu libro suba de categoría.",
    precio: "A cotizar",
  },
];

const EMAIL_E = "zngvnfwbrybegvm11@tznvy.pbz";
---

<section id="clinica" class="clinica">

  <div class="clinica-encabezado">
    <span class="clinica-eyebrow">Servicio</span>
    <h2 class="clinica-titulo">Clínica de obra</h2>
  </div>

  <div class="clinica-tiers">
    {tiers.map((t, i) => (
      <article class="tier" style={`--acc:${t.acc}; animation-delay:${i * 90}ms`}>
        <span class="tier-num" aria-hidden="true">{t.num}</span>
        <h3 class="tier-nombre">{t.nombre}</h3>
        <p class="tier-desc">{t.desc}</p>
        <a href="#" class="tier-precio email-link" data-e={EMAIL_E}>{t.precio}</a>
      </article>
    ))}
  </div>

  <div class="clinica-cta">
    <p class="cta-pregunta">¿Tenés un manuscrito que necesita un ojo serio?</p>
    <p class="cta-cuerpo">
      Un cuento, una novela, un libro entero. Trabajo con narrativa:
      ciencia ficción, realismo, lo que tenga sangre adentro.
    </p>
    <a href="#" class="cta-link email-link" data-e={EMAIL_E}>Escribime →</a>
    <span class="cta-fina">50% por adelantado · Devolución honesta · Sin relleno</span>
  </div>

</section>

<style>
.clinica {
  overflow: hidden;
  border-top: 1px solid var(--linea);
  border-bottom: 1px solid var(--linea);
  padding: 5rem 0 4.5rem;
  position: relative;
  scroll-margin-top: 1.5rem;
}

/* ── Encabezado (centrado, con más peso y más aire) ── */
.clinica-encabezado {
  max-width: 780px;
  margin: 0 auto 4.2rem;
  padding: 0 3rem;
  text-align: center;
}

.clinica-eyebrow {
  display: block;
  font-family: 'Cormorant Garamond', serif;
  font-style: normal;
  font-size: 0.85rem;
  font-weight: 600;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: var(--oxido);
  margin-bottom: 1.1rem;
}

.clinica-titulo {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-weight: 600;
  font-size: clamp(2.6rem, 5.5vw, 4rem);
  color: var(--crema);
  line-height: 1.04;
  margin: 0;
  text-shadow: 0 0 38px rgba(184, 74, 26, 0.22);
}

/* ── Tarjetas (diferenciadas por acento, sin cambiar el fondo) ── */
.clinica-tiers {
  max-width: 940px;
  margin: 0 auto;
  padding: 0 3rem;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.1rem;
  align-items: stretch;
}

.tier {
  background: linear-gradient(180deg, rgba(28, 28, 38, 0.55), rgba(17, 17, 24, 0.5));
  border: 1px solid color-mix(in srgb, var(--acc) 16%, var(--linea));
  border-top: 2px solid var(--acc);
  border-radius: 4px;
  padding: 1.9rem 1.6rem 1.6rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
  opacity: 0;
  transform: translateY(10px);
  animation: tierIn 0.5s ease forwards;
}

.tier:hover {
  border-color: color-mix(in srgb, var(--acc) 50%, transparent);
  border-top-color: var(--acc);
  box-shadow: 0 16px 46px -26px var(--acc);
  transform: translateY(-3px);
}

@keyframes tierIn {
  to { opacity: 1; transform: translateY(0); }
}

.tier-num {
  font-family: 'Cormorant Garamond', serif;
  font-style: normal;
  font-weight: 600;
  font-size: 1rem;
  letter-spacing: 0.2em;
  color: var(--acc);
  user-select: none;
  margin-bottom: 0.9rem;
}

.tier-nombre {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-weight: 600;
  font-size: 1.35rem;
  color: var(--crema);
  line-height: 1.18;
  margin: 0 0 1.1rem;
}

/* Descripción centrada verticalmente: equilibra las tres cajas aunque el texto sea desigual */
.tier-desc {
  font-family: 'Barlow', sans-serif;
  font-weight: 400;
  font-size: 0.97rem;
  color: #d4cec2;
  line-height: 1.75;
  letter-spacing: 0.008em;
  margin: 0 0 1.5rem;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* Precio = pie de tarjeta, alineado abajo en las tres, cliqueable (abre el contacto) */
.tier-precio {
  width: 100%;
  padding-top: 1.1rem;
  border-top: 1px solid color-mix(in srgb, var(--acc) 32%, transparent);
  font-family: 'Cormorant Garamond', serif;
  font-style: normal;
  font-weight: 600;
  font-size: 0.95rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--acc);
  text-decoration: none;
  display: block;
  transition: color 0.2s;
}
.tier-precio::after {
  content: ' · escribime →';
  color: var(--gris);
  opacity: 0.7;
  font-size: 0.8rem;
  text-transform: none;
  letter-spacing: 0.04em;
}
.tier-precio:hover { color: var(--crema); }
.tier-precio:hover::after { color: var(--acc); opacity: 1; }

/* ── CTA (centrado, con aire, botón con carácter) ── */
.clinica-cta {
  max-width: 600px;
  margin: 4.2rem auto 0;
  padding: 3rem 1.5rem 0;
  border-top: 1px solid var(--linea);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 1.1rem;
}

.cta-pregunta {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 1.6rem;
  color: var(--crema);
  margin: 0;
  line-height: 1.25;
}

.cta-cuerpo {
  font-family: 'Barlow', sans-serif;
  font-weight: 400;
  font-size: 0.97rem;
  color: #c4beb3;
  line-height: 1.7;
  margin: 0;
  max-width: 44ch;
}

/* Botón: Cormorant itálica, frase, flecha, más cuerpo y un hover que invita */
.cta-link {
  display: inline-block;
  margin-top: 0.8rem;
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-weight: 600;
  font-size: 1.25rem;
  letter-spacing: 0.01em;
  color: var(--negro);
  background: var(--oxido);
  border: 1px solid var(--oxido);
  padding: 0.6rem 2.6rem;
  text-decoration: none;
  border-radius: 3px;
  box-shadow: 0 8px 30px -12px var(--oxido);
  transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
}
.cta-link:hover {
  transform: translateY(-2px);
  background: var(--ambar);
  box-shadow: 0 14px 38px -12px var(--oxido);
}

.cta-fina {
  font-family: 'Cormorant Garamond', serif;
  font-style: normal;
  font-size: 0.82rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(232, 224, 208, 0.72);
}

/* ── Responsive ── */
@media (max-width: 700px) {
  .clinica-encabezado { padding: 0 1.5rem; margin-bottom: 3.2rem; }
  .clinica-tiers {
    grid-template-columns: 1fr;
    padding: 0 1.5rem;
    gap: 1rem;
  }
  .tier { padding: 1.6rem 1.5rem 1.4rem; }
  .clinica-cta { padding: 2.6rem 1.5rem 0; }
}

@media (prefers-reduced-motion: reduce) {
  .tier { animation: none; opacity: 1; transform: none; }
  .tier:hover { transform: none; }
  .cta-link:hover { transform: none; }
}
</style>
