---
// src/components/ClinicaDeObra.astro
// Sección de servicio: lectura, corrección y acompañamiento de manuscritos.
// Reemplaza a la antigua "Lectura en voz alta".

const tiers = [
  {
    num: "I",
    nombre: "Devolución Cruda",
    desc: "Te leo con hambre de saber qué te hace diferente a los miles de manuscritos que se escriben por año. Te hago una carta de devolución honesta: dónde estás fuerte, dónde el texto se cae y necesitás afilar, y por dónde seguir.",
    precio: "Desde USD 35",
  },
  {
    num: "II",
    nombre: "Corrección + Devolución Cruda",
    desc: "Lo anterior más correcciones párrafo a párrafo. Pero acá no corregimos tu estilo: lo identificamos hasta que sepa pegar. Cada voz es única.",
    precio: "Desde USD 90",
  },
  {
    num: "III",
    nombre: "Curaduría de Obra",
    desc: "Laburo sobre un manuscrito completo. Hacemos videollamada, varias rondas, corrección y seguimiento hasta que tu libro suba de categoría.",
    precio: "A cotizar",
  },
];
---

<section id="clinica" class="clinica">

  <div class="clinica-encabezado">
    <span class="clinica-eyebrow">Servicio</span>
    <h2 class="clinica-titulo">Clínica de obra</h2>
    <p class="clinica-bajada">
      No soy taller ni academia. Soy un escritor que lee tu manuscrito
      como editor: te digo dónde el texto miente, dónde afloja y dónde está vivo.
    </p>
  </div>

  <div class="clinica-tiers">
    {tiers.map((t, i) => (
      <article class="tier" style={`animation-delay: ${i * 90}ms`}>
        <span class="tier-num" aria-hidden="true">{t.num}</span>
        <h3 class="tier-nombre">{t.nombre}</h3>
        <p class="tier-desc">{t.desc}</p>
        <span class="tier-precio">{t.precio}</span>
      </article>
    ))}
  </div>

  <div class="clinica-cta">
    <p class="cta-pregunta">¿Tenés un manuscrito que necesita un ojo serio?</p>
    <p class="cta-cuerpo">
      Un cuento, una novela, un libro entero.<br />
      Trabajo con narrativa: ciencia ficción, realismo, lo que tenga sangre adentro.
    </p>
    <a href="#" class="cta-link email-link" data-e="zngvnfwbrybegvm11@tznvy.pbz">Escribime</a>
    <span class="cta-fina">50% por adelantado · Devolución honesta · Sin relleno</span>
  </div>

</section>

<style>
.clinica {
  overflow: hidden;
  border-top: 1px solid var(--linea);
  border-bottom: 1px solid var(--linea);
  padding: 5rem 0 4.5rem;
  position: relative;
}

/* ── Encabezado ─────────────────────── */
.clinica-encabezado {
  max-width: 780px;
  margin: 0 auto 3rem;
  padding: 0 3rem;
}

.clinica-eyebrow {
  display: block;
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--oxido);
  margin-bottom: 0.8rem;
}

.clinica-titulo {
  font-family: 'Cormorant Garamond', serif;
  font-weight: 600;
  font-size: clamp(1.8rem, 3.5vw, 2.6rem);
  color: var(--crema);
  line-height: 1.1;
  margin: 0 0 0.9rem;
}

/* Mismo motif que .hero-bajada */
.clinica-bajada {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 1.05rem;
  color: var(--gris);
  line-height: 1.55;
  margin: 0;
  border-left: 2px solid var(--oxido);
  padding-left: 1rem;
  max-width: 460px;
}

/* ── Tiers ──────────────────────────── */
.clinica-tiers {
  max-width: 820px;
  margin: 0 auto;
  padding: 0 3rem;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  border-top: 1px solid var(--linea);
}

.tier {
  padding: 2rem 1.5rem 2.2rem;
  border-bottom: 1px solid var(--linea);
  border-left: 1px solid var(--linea);
  display: flex;
  flex-direction: column;
  position: relative;
  /* Entrada animada — mismo patrón que .track en el feed */
  opacity: 0;
  transform: translateY(10px);
  animation: tierIn 0.5s ease forwards;
}

.tier:first-child { border-left: none; }

/* Acento superior al pasar el cursor — mismo motif óxido */
.tier::before {
  content: '';
  position: absolute;
  left: 0; right: 0; top: -1px;
  height: 2px;
  background: transparent;
  transition: background 0.25s;
}

.tier:hover::before { background: var(--oxido); }

@keyframes tierIn {
  to { opacity: 1; transform: translateY(0); }
}

.tier-num {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.7rem;
  letter-spacing: 0.2em;
  color: var(--gris);
  opacity: 0.45;
  user-select: none;
  margin-bottom: 1rem;
}

.tier-nombre {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-weight: 600;
  font-size: 1.3rem;
  color: var(--crema);
  line-height: 1.15;
  margin: 0 0 0.9rem;
}

.tier-desc {
  font-family: 'Barlow', sans-serif;
  font-weight: 400;
  font-size: 0.98rem;
  color: #d4cec2;
  line-height: 1.78;
  letter-spacing: 0.008em;
  margin: 0 0 1.5rem;
  flex: 1;
}

.tier-precio {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.72rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--oxido);
  margin-top: auto;
}

/* ── CTA ────────────────────────────── */
.clinica-cta {
  max-width: 820px;
  margin: 3.5rem auto 0;
  padding: 2.5rem 3rem 0;
  border-top: 1px solid var(--linea);
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.cta-pregunta {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 1.35rem;
  color: var(--crema);
  margin: 0;
}

.cta-cuerpo {
  font-family: 'Barlow', sans-serif;
  font-weight: 300;
  font-size: 0.95rem;
  color: var(--gris);
  line-height: 1.6;
  margin: 0 0 1rem;
}

/* Mismo estilo que .libro-fin-contacto / la CTA anterior */
.cta-link {
  display: inline-block;
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.7rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--oxido);
  border: 1px solid rgba(184, 74, 26, 0.28);
  padding: 0.55rem 1.8rem;
  text-decoration: none;
  border-radius: 2px;
  width: fit-content;
  transition: background 0.2s, color 0.2s;
}

.cta-link:hover {
  background: var(--oxido);
  color: var(--negro);
}

.cta-fina {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.65rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--gris);
  opacity: 0.4;
  margin-top: 0.4rem;
}

/* ── Responsive ─────────────────────── */
@media (max-width: 700px) {
  .clinica-encabezado,
  .clinica-tiers,
  .clinica-cta {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .clinica-tiers {
    grid-template-columns: 1fr;
  }

  .tier {
    border-left: none;
    padding: 1.6rem 0 1.8rem;
  }

  .tier::before { left: 0; right: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .tier { animation: none; opacity: 1; transform: none; }
}
</style>
